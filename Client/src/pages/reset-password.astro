<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="referrer" content="no-referrer">
<title>Agenda — Nueva contraseña</title>
<style>
body{margin:0;min-height:100vh;display:grid;place-items:center;background:#f4f2ef;color:#2c2a27;font:16px system-ui,sans-serif;padding:20px;box-sizing:border-box}
main{width:min(100%,420px);background:#faf9f7;padding:32px;border:1px solid #e4e0dc;border-radius:6px}h1{font-size:1.5rem}label{display:block;margin:20px 0 8px}input,button{box-sizing:border-box;width:100%;padding:13px;font:inherit;border-radius:4px}input{border:1px solid #aaa59f}button{margin-top:20px;border:0;background:#2c2a27;color:white;cursor:pointer}button:disabled{opacity:.6}a{color:inherit}#message{margin-top:16px;line-height:1.5}
</style></head>
<body><main><h1>Establecer nueva contraseña</h1>
<form id="form">
<label for="password">Nueva contraseña (mínimo 12 caracteres)</label><input id="password" type="password" autocomplete="new-password" required minlength="12">
<label for="confirm">Repetir contraseña</label><input id="confirm" type="password" autocomplete="new-password" required minlength="12">
<button id="submit" type="submit">Guardar contraseña</button></form>
<p id="message" role="status" aria-live="polite"></p><p><a href="/login">Volver a iniciar sesión</a></p>
</main>
<script>
import { apiFetch } from "../services/api";
const token=new URLSearchParams(location.search).get("token");
history.replaceState(null,"",location.pathname);
const form=document.querySelector<HTMLFormElement>("#form")!;
const button=document.querySelector<HTMLButtonElement>("#submit")!;
const message=document.querySelector<HTMLElement>("#message")!;
if(!token){button.disabled=true;message.textContent="El enlace es inválido. Solicita uno nuevo.";}
form.addEventListener("submit",async(event)=>{
 event.preventDefault();
 if(!token||!form.reportValidity())return;
 const password=document.querySelector<HTMLInputElement>("#password")!.value;
 const confirm=document.querySelector<HTMLInputElement>("#confirm")!.value;
 if(password!==confirm){message.textContent="Las contraseñas no coinciden.";return;}
 button.disabled=true;message.textContent="";
 try{
  await apiFetch("/reset-password",{method:"POST",body:{token,newPassword:password}});
  message.textContent="Contraseña actualizada. Ya puedes iniciar sesión.";
  form.reset();form.hidden=true;
 }catch(error){message.textContent="No se pudo actualizar la contraseña. Solicita un enlace nuevo si expiró.";}
 finally{button.disabled=false;}
});
</script></body></html>

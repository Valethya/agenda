---
import PublicBookingFlow from '../features/public-booking/PublicBookingFlow';
import '../styles/global.scss';

const slug = Astro.url.searchParams.get('slug');
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Reservar una hora | Agenda</title>
  </head>
  <body>
    <PublicBookingFlow slug={slug} client:load />
  </body>
</html>

<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Agenda — Recuperar acceso</title>
<style>
body{margin:0;min-height:100vh;display:grid;place-items:center;background:#f4f2ef;color:#2c2a27;font:16px system-ui,sans-serif;padding:20px;box-sizing:border-box}
main{width:min(100%,420px);background:#faf9f7;padding:32px;border:1px solid #e4e0dc;border-radius:6px}
h1{font-size:1.5rem}label{display:block;margin:24px 0 8px}input,button{box-sizing:border-box;width:100%;padding:13px;font:inherit;border-radius:4px}input{border:1px solid #aaa59f}button{margin-top:18px;border:0;background:#2c2a27;color:white;cursor:pointer}button:disabled{opacity:.6}a{color:inherit}#message{margin-top:16px;line-height:1.5}
</style>
</head>
<body><main>
<h1>Recuperar contraseña</h1>
<p>Ingresa tu correo. Si existe una cuenta asociada, recibirás un enlace para establecer una nueva contraseña.</p>
<form id="form"><label for="email">Correo electrónico</label><input id="email" type="email" autocomplete="email" required maxlength="254"><button id="submit" type="submit">Enviar enlace</button></form>
<p id="message" role="status" aria-live="polite"></p>
<p><a href="/login">Volver a iniciar sesión</a></p>
</main>
<script>
import { apiFetch } from "../services/api";
const form=document.querySelector<HTMLFormElement>("#form")!;
const button=document.querySelector<HTMLButtonElement>("#submit")!;
const message=document.querySelector<HTMLElement>("#message")!;
form.addEventListener("submit",async(event)=>{
 event.preventDefault();
 if(!form.reportValidity())return;
 button.disabled=true;message.textContent="";
 try{
  await apiFetch("/forgot-password",{method:"POST",body:{email:(document.querySelector<HTMLInputElement>("#email")!).value.trim()}});
  message.textContent="Si existe una cuenta asociada, recibirás un correo con instrucciones.";
  form.reset();
 }catch(error){
  message.textContent="No pudimos procesar la solicitud. Intenta nuevamente más tarde.";
 }finally{button.disabled=false;}
});
</script></body></html>
